# --- Site (frontend) : valeurs PUBLIQUES, copiez ce fichier en « .env » ---
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# --- Fonctions serveur (supabase secrets set ...) : NE JAMAIS mettre dans le frontend ---
# URL publique du site (retour de paiement, CORS)
SITE_URL=https://votre-site.example
# E-mails (Resend)
RESEND_API_KEY=
MAIL_FROM="BIG JEFE <reservations@votre-domaine.example>"
# Paiement (FedaPay) — « sandbox » pour les tests, « live » en production
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
# Première configuration du compte propriétaire (page /admin) : code secret de votre choix, à retirer ensuite si vous voulez
SETUP_CODE=
